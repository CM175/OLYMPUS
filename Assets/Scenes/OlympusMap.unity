  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OlympusArena.OlympusMapGenerator
  blueprint: '// HALF MAP (Team A). Row 0 = Team A spawn, last row touches the centre
    line.

    // The other half is generated by symmetry. Lines starting with //
    are ignored.

    // Cells overlapping the centre island (see ''Center Island
    Half Tiles'') are skipped.

    ....SSSSSSS....

    ..#=SSSSSSS=#..

    .###.==.==.###.

    .###.==.==.###.

    .#T#C##P##C#T#.

    .j#>D#J#J#D<#j.

    .=##.......##=.

    .#C#.......#C#.

    .###.......###.

'
